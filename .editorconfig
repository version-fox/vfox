# Settings for shfmt (the CI formatting check) and for editors. The indent
# width of each shell script is the one it already had. shfmt re-indented nine
# lines in two of them: four assignments in install.sh (from 6 to 4 spaces) and
# five continuation lines in scripts/install-test.sh (from 4 to 6 spaces).
root = true

[install.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[scripts/install-test.sh]
indent_style = space
indent_size = 2

[scripts/{bump,e2e-test}.sh]
indent_style = space
indent_size = 4
